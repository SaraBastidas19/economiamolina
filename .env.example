# Copia este archivo como .env.local y completa los valores.

# Número de WhatsApp del negocio en formato internacional, sin "+" ni espacios.
# Mientras esté vacío, los botones de WhatsApp se muestran deshabilitados.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (para metadatos, sitemap y enlaces canónicos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon "true" solo cuando el catálogo tenga productos reales.
SITE_INDEXABLE=false
